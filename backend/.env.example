# App
ENV=dev
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://tradesentinel:tradesentinel@postgres:5432/tradesentinel

# Redis
REDIS_URL=redis://redis:6379/0

# Trading mode: paper (default, safe) or live (real money via ccxt)
TRADING_MODE=paper
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true

# Risk management
MAX_POSITION_SIZE_PCT=0.10
MAX_DAILY_DRAWDOWN_PCT=0.05
DEFAULT_STOP_LOSS_PCT=0.03
DEFAULT_TAKE_PROFIT_PCT=0.06

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
KAVEHNEGAR_API_KEY=
ALERT_PHONE_NUMBER=

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
